# Local development database. The path is relative to the backend working directory.
DATABASE_URL=sqlite:///./inkloom.db

# Create the first Admin only when the database has no users.
# Replace both values with your own unique credentials before starting the API.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Browser frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local HTTP development only. Set true when the API is served over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12

# Upload and analysis limits.
MAX_CONTENT_LENGTH=100000
MAX_UPLOAD_SIZE=10485760
MAX_SOURCE_UPLOAD_SIZE=10485760
MAX_SOURCE_LENGTH=200000
MAX_IMAGE_PIXELS=40000000
MAX_RETRIEVAL_CHUNKS=200

# Deterministic publish risk weights and score thresholds (0-100).
RISK_WEIGHT_CRITICAL=30
RISK_WEIGHT_HIGH=18
RISK_WEIGHT_MEDIUM=8
RISK_WEIGHT_LOW=3
PUBLISH_RISK_MEDIUM_THRESHOLD=20
PUBLISH_RISK_HIGH_THRESHOLD=45
PUBLISH_RISK_CRITICAL_THRESHOLD=70

# Optional OCR. Also install the Tesseract executable on the host to use it.
OCR_ENABLED=false

# Optional visual brand checks. Leave palette and paths empty until approved values
# and actual local reference files are available.
BRAND_PALETTE=
PALETTE_TOLERANCE=36
BRAND_ASSET_REFERENCE_PATHS=
# BRAND_ASSET_SIMILARITY_THRESHOLD=72

# Optional LLM chat provider. Configure provider, URL, key, and model together.
# Defaults to OpenAI-compatible chat. Leave URL/key/model blank for deterministic rules.
LLM_PROVIDER=openai
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Gemini request timeout in seconds (default 90; allowed range 1-300).
GEMINI_REQUEST_TIMEOUT_SECONDS=90
# For OpenAI-compatible chat, use https://api.openai.com/v1.
# To use Gemini, set:
# LLM_PROVIDER=gemini
# LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_API_KEY=
# LLM_MODEL=gemini-3.8-flash
# Gemini free-tier access, quotas, and availability depend on the Google project
# and may change. Review Google's data-use terms before sending content.

# Optional OpenAI-compatible embeddings; Gemini chat uses lexical retrieval instead.
EMBEDDING_MODEL=

# Optional external factual-search provider. Only enable after reviewing data handling.
FACT_CHECK_PROVIDER=
FACT_CHECK_API_KEY=
TRUSTED_SOURCE_DOMAINS=

# Optional email. Configure all required SMTP settings together to enable invitations
# and password recovery. Use STARTTLS or implicit TLS; do not use plaintext SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_BASE_URL=http://localhost:5173
